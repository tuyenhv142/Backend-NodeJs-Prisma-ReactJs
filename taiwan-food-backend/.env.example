# ── Server ──────────────────────────────────────────
PORT=8765
HOST=0.0.0.0
NODE_ENV=development

# ── Database ───────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/taiwan_food_db"

# ── Auth ───────────────────────────────────────────
# Dùng openssl rand -hex 64 để sinh JWT_SECRET mạnh
JWT_SECRET="change-me-to-a-random-64-char-string"
SERVER_API_KEY="change-me-to-a-random-api-key"

# ── CORS ───────────────────────────────────────────
# Production: set to your frontend domain
CORS_ORIGIN=http://localhost:5173

# ── YouTube Data API ───────────────────────────────
YOUTUBE_API_KEY="your-youtube-api-key"

# ── Google Places API ──────────────────────────────
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
